# Development accepts loopback clients only without a password.
APP_ENV=development
RECRUITAI_DB=var/recruitai.sqlite3
# Production: minimum 16 characters. Use a secret manager.
RECRUITAI_PASSWORD=
# Set this when behind an HTTPS reverse proxy:
# RECRUITAI_ORIGIN=https://recruitai.your-company.com
# Optional: each upload also requires explicit opt-in.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
